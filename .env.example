# Existing ImageShield backend — the same API the mobile app talks to.
# Server-side only: no NEXT_PUBLIC_ prefix, so it never reaches the browser.
BACKEND_URL=https://imageshield.ai:5000

# Universal link / App Link that opens the app directly when it is installed.
NEXT_PUBLIC_APP_DEEP_LINK=https://imageshield.ai/open

# How many proxies sit in front of this app, each appending to X-Forwarded-For.
# Defaults to 1 — an nginx in front. The per-IP OTP limit counts against the entry
# that many from the RIGHT of that header, which is the one the nearest proxy wrote
# and so the one a client cannot forge; leftmost entries are whatever the caller
# claimed. Set to 0 when nothing trusted is in front (every caller then shares one
# bucket), or to 2+ when a CDN also appends.
TRUSTED_PROXY_HOPS=1

# Signs the funnel's session cookie, which is what proves a phone number was
# verified before a score is written for it. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FUNNEL_SECRET=replace-me
