# Existing ImageShield backend — the same API the mobile app talks to.
# Server-side only: no NEXT_PUBLIC_ prefix, so it never reaches the browser.
BACKEND_URL=https://imageshield.ai:5000

# Universal link / App Link that opens the app directly when it is installed.
NEXT_PUBLIC_APP_DEEP_LINK=https://imageshield.ai/open

# Signs the funnel's session cookie, which is what proves a phone number was
# verified before a score is written for it. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FUNNEL_SECRET=replace-me
